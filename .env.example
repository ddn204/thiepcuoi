# File mẫu — KHÔNG điền giá trị thật vào đây (file này được commit lên git).
# Copy thành .env (đã bị .gitignore) rồi điền giá trị thật.
# Lấy trong Supabase Dashboard → Project Settings → API.

# Dùng cho frontend (lộ ra trình duyệt là bình thường)
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# hoặc anon key kiểu cũ
SUPABASE_ANON_KEY=

# Chỉ dùng phía server / chạy migration — TUYỆT ĐỐI không đưa vào frontend
POSTGRES_URL_NON_POOLING=postgres://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
